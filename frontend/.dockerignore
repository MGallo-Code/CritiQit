# CritiQit Frontend - Docker Ignore
# Excludes files from Docker build context for faster builds and smaller images

# Dependencies (reinstalled in Dockerfile)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output (rebuilt in Dockerfile)
.next
out

# Testing
coverage
.nyc_output

# Environment variables (passed at runtime, not baked into image)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Git
.git
.gitignore
.gitattributes

# Documentation (not needed in production image)
README.md
CHANGELOG.md
docs/

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Misc development files
*.md
.eslintcache
tsconfig.tsbuildinfo

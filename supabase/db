#!/bin/bash

# CritiQit Supabase Database Management Tool
# Can be run from anywhere - automatically changes to supabase/ directory

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Change to the supabase directory (where this script lives)
cd "$SCRIPT_DIR"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Verify we're in the right directory
if [ ! -f "compose.yml" ]; then
    echo -e "${RED}❌ Error: Script directory doesn't contain compose.yml${NC}"
    exit 1
fi

# Source environment variables
source .env

# Helper functions
print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

confirm() {
    local message="$1"
    local skip_confirm="$2"

    if [ "$skip_confirm" = true ]; then
        return 0
    fi

    echo -e "${YELLOW}${message}${NC}"
    read -p "Continue? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        exit 1
    fi
}

# Command functions
cmd_reset_hard() {
    local skip_confirm=false
    if [ "$1" = "--yes" ] || [ "$1" = "-y" ]; then
        skip_confirm=true
    fi

    confirm "This will DELETE ALL DATA and reset the database from scratch!" "$skip_confirm"

    print_info "Running hard reset..."
    ./scripts/reset-hard-db.sh
    print_success "Hard reset completed!"
}

cmd_reset_soft() {
    local skip_confirm=false
    if [ "$1" = "--yes" ] || [ "$1" = "-y" ]; then
        skip_confirm=true
    fi

    confirm "This will reset the database but preserve volumes." "$skip_confirm"

    print_info "Running soft reset..."
    ./scripts/reset-soft-db.sh
    print_success "Soft reset completed!"
}

cmd_start() {
    print_info "Starting containers..."
    docker compose up -d
    print_success "Containers started!"
}

cmd_stop() {
    print_info "Stopping containers..."
    docker compose stop
    print_success "Containers stopped!"
}

cmd_restart() {
    print_info "Restarting containers..."
    ./scripts/restart-db.sh
    print_success "Containers restarted!"
}

cmd_seed() {
    local target="${1:-all}"

    case "$target" in
        templates)
            print_info "Uploading email templates..."
            ./scripts/upload-templates.sh
            print_success "Email templates uploaded!"
            ;;
        all)
            print_info "Uploading all seed data..."
            ./scripts/upload-templates.sh
            print_success "All seed data uploaded!"
            ;;
        *)
            print_error "Unknown seed target: $target"
            echo "Usage: db seed [templates|all]"
            exit 1
            ;;
    esac
}

cmd_status() {
    print_info "Container Status:"
    echo ""
    docker compose ps
    echo ""

    print_info "Recent Migrations:"
    echo ""
    # Check if database is accessible
    if docker compose exec -T db psql -U supabase_admin -d postgres -c "SELECT version, name FROM supabase_migrations.schema_migrations ORDER BY version DESC LIMIT 5;" 2>/dev/null; then
        :
    else
        print_warning "Database not accessible or migrations table doesn't exist"
    fi
}

cmd_migrate() {
    print_info "Applying migrations..."
    supabase db push --db-url "${DB_URL}" --yes --debug
    print_success "Migrations applied!"
}

show_help() {
    echo -e "${BLUE}CritiQit Supabase Database Management Tool${NC}"
    echo ""
    echo -e "${GREEN}USAGE:${NC}"
    echo "    ./db <command> [options]"
    echo ""
    echo -e "${GREEN}COMMANDS:${NC}"
    echo -e "    ${YELLOW}start${NC}                 Start Docker containers"
    echo -e "    ${YELLOW}stop${NC}                  Stop Docker containers"
    echo -e "    ${YELLOW}restart${NC}               Restart Docker containers"
    echo -e "    ${YELLOW}reset hard${NC} [--yes]    Reset database completely (DESTRUCTIVE)"
    echo -e "    ${YELLOW}reset soft${NC} [--yes]    Reset database, preserve volumes"
    echo -e "    ${YELLOW}seed${NC} [target]         Upload seed data"
    echo "                          Targets: templates, all (default: all)"
    echo -e "    ${YELLOW}status${NC}                Show container status and recent migrations"
    echo -e "    ${YELLOW}migrate${NC}               Apply migrations without reset"
    echo -e "    ${YELLOW}help${NC}                  Show this help message"
    echo ""
    echo -e "${GREEN}OPTIONS:${NC}"
    echo -e "    ${YELLOW}--yes, -y${NC}             Skip confirmation prompts"
    echo ""
    echo -e "${GREEN}EXAMPLES:${NC}"
    echo "    ./db                    # Interactive menu"
    echo "    ./db start              # Start containers"
    echo "    ./db stop               # Stop containers"
    echo "    ./db reset hard         # Full reset with confirmation"
    echo "    ./db reset hard --yes   # Full reset, skip confirmation"
    echo "    ./db seed               # Upload all seed data"
    echo "    ./db status             # Check status"
    echo "    ./db migrate            # Apply migrations"
    echo ""
    echo -e "${GREEN}NOTES:${NC}"
    echo "    - Can be run from anywhere (auto-navigates to supabase/)"
    echo "    - Destructive operations require confirmation (unless --yes is used)"
    echo "    - Use 'reset hard' for testing migrations from scratch"
    echo "    - Use 'seed' after reset to populate initial data"
    echo ""
}

show_interactive_menu() {
    while true; do
        echo ""
        echo -e "${BLUE}════════════════════════════════════════${NC}"
        echo -e "${BLUE}   CritiQit Supabase Manager${NC}"
        echo -e "${BLUE}════════════════════════════════════════${NC}"
        echo ""
        echo "  1. Start Containers"
        echo "  2. Stop Containers"
        echo "  3. Restart Containers"
        echo "  4. Reset Database (hard - DESTRUCTIVE)"
        echo "  5. Reset Database (soft - preserves volumes)"
        echo "  6. Seed Data (all)"
        echo "  7. Seed Templates Only"
        echo "  8. Check Status"
        echo " 9. Apply Migrations"
        echo " 10. Exit"
        echo ""
        read -p "Select option (1-11): " choice

        case "$choice" in
            1) cmd_start ;;
            2) cmd_stop ;;
            3) cmd_restart ;;
            4) cmd_reset_hard ;;
            5) cmd_reset_soft ;;
            6) cmd_seed all ;;
            7) cmd_seed templates ;;
            8) cmd_status ;;
            9) cmd_migrate ;;
            10) echo "Goodbye!"; exit 0 ;;
            *) print_error "Invalid option. Please select 1-11." ;;
        esac

        echo ""
        read -p "Press Enter to continue..."
    done
}

# Main command router
main() {
    local command="${1:-}"

    # If no command, show interactive menu
    if [ -z "$command" ]; then
        show_interactive_menu
        exit 0
    fi

    case "$command" in
        start)
            cmd_start
            ;;
        stop)
            cmd_stop
            ;;
        restart)
            cmd_restart
            ;;
        reset)
            local subcommand="${2:-}"
            case "$subcommand" in
                hard) cmd_reset_hard "$3" ;;
                soft) cmd_reset_soft "$3" ;;
                *)
                    print_error "Unknown reset type: $subcommand"
                    echo "Usage: db reset [hard|soft] [--yes]"
                    exit 1
                    ;;
            esac
            ;;
        seed)
            cmd_seed "$2"
            ;;
        status)
            cmd_status
            ;;
        migrate)
            cmd_migrate
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            print_error "Unknown command: $command"
            echo "Run './db help' for usage information"
            exit 1
            ;;
    esac
}

main "$@"
